# Configurações do Banco de Dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ia_amanda
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Configurações do Redis
REDIS_URL=redis://localhost:6379/0

# Configurações do# Evolution API (Ghosthub)
EVOLUTION_API_URL=https://api-wpp.ghosthub.com.br
EVOLUTION_API_KEY=sua_api_key_aqui
INSTANCE_NAME=amanda_teste

# LangSmith (Observabilidade e Tracing da IA)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=sua_langchain_api_key_aqui
LANGCHAIN_PROJECT=ia_amanda_producao

# Configurações de LLM
OPENAI_API_KEY=sk-sua-chave-openai-aqui
# ANTHROPIC_API_KEY=sua-chave-anthropic-aqui

# Configurações do FastAPI
API_V1_STR=/api/v1
PROJECT_NAME=IA Amanda - Sistema de Recepção Inteligente
