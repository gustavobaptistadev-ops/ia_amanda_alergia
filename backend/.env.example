# Configurações do Banco de Dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ia_amanda
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Configurações do Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Observabilidade (Langfuse)
# [AVISO LGPD - PRODUÇÃO]: Ao configurar o Langfuse para uma clínica real (produção), 
# certifique-se de DESATIVAR a opção "Enable AI powered features" nas configurações
# organizacionais do Langfuse para evitar o envio de dados sensíveis de pacientes 
# para serviços terceiros da AWS Bedrock. (Para testes, pode deixar ativado).
LANGFUSE_PUBLIC_KEY=sua_chave_publica_aqui
LANGFUSE_SECRET_KEY=sua_chave_secreta_aqui
LANGFUSE_HOST=https://cloud.langfuse.com

# Configurações do# Evolution API (Ghosthub)
EVOLUTION_API_URL=https://api-wpp.ghosthub.com.br
EVOLUTION_API_KEY=sua_api_key_aqui
EVOLUTION_GLOBAL_KEY=sua_chave_global_aqui
EVOLUTION_INSTANCE_NAME=amanda_teste

# LangSmith (Observabilidade e Tracing da IA)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=sua_langchain_api_key_aqui
LANGCHAIN_PROJECT=ia_amanda_producao

# Configurações de LLM
OPENAI_API_KEY=sk-sua-chave-openai-aqui
# ANTHROPIC_API_KEY=sua-chave-anthropic-aqui

# Configurações do FastAPI
API_V1_STR=/api/v1
CORS_ORIGINS=https://your-frontend.example.com,http://localhost:3000
PUBLIC_API_URL=https://your-api.example.com
INTERNAL_API_KEY=generate-a-unique-random-secret-at-least-32-characters
WEBHOOK_SECRET=generate-another-unique-random-secret-at-least-32-characters
JWT_SECRET_KEY=generate-a-third-unique-random-secret-at-least-32-characters
ENCRYPTION_KEY=generate-and-manage-a-fernet-key-in-your-secret-manager
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=none
INITIAL_ADMIN_PASSWORD=set-only-during-bootstrap-and-rotate-afterward
PROJECT_NAME=IA Amanda - Sistema de Recepção Inteligente
